generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrgStatus {
  active
  inactive
  pending_setup
}


enum BehaviorType {
  expected_behavior
  unacceptable_behavior
}

enum RoleLevel {
  junior
  mid
  senior
  lead
  head
}

enum EmploymentType {
  full_time
  part_time
  contract
}

enum EmployeeStatus {
  active
  inactive
}

// Availability (leave) is a separate, dated concept — see the Leave model. A leave's
// approval state; availability is computed from this (see LeaveState effectiveness rules).
enum LeaveState {
  pending
  approved
  rejected
  cancelled
}

// How a leave came to exist: a normal request that goes through approval, or one the
// employee declared directly (e.g. an unplanned sick day) with no prior approval.
enum LeaveOrigin {
  requested
  self_declared
}

enum AnnouncementType {
  announcement
  circular
}

enum AnnouncementPriority {
  normal
  important
  urgent
}

enum CommunicationScope {
  company_wide
  department
}

enum BoardInteractionMode {
  read_only
  comments_only
  comments_and_reactions
}

enum ConversationType {
  direct
  group
}

enum ChatMemberRole {
  admin
  member
}

enum ContentType {
  video
  document
  url
  article
  file // a document uploaded to R2 (pdf / office / image / video / audio)
}

// Preview state for an uploaded file. Native-viewable files (pdf/image/av) are
// `ready` immediately; office docs are `pending` until LibreOffice converts them
// to a preview PDF (→ `ready`), or `failed` if conversion isn't available.
// `none` = nothing to preview (e.g. a zip) — download only.
enum LearningPreviewStatus {
  none
  pending
  ready
  failed
}

enum LearningPathStatus {
  draft
  published
  archived
}

enum AssignmentStatus {
  not_started
  in_progress
  completed
}

enum SequentialMode {
  sequential
  free_form
}

enum CompletionType {
  manual
  auto_opened
}

model OrganizationGroup {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique
  description   String?
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
  organizations Organization[]

  @@map("organization_groups")
}

model Organization {
  id         String    @id @default(uuid())
  name       String
  slug       String    @unique
  logo_url   String?
  industry   String?
  country    String?
  timezone   String?
  status     OrgStatus @default(pending_setup)
  group_id   String?
  group      OrganizationGroup? @relation(fields: [group_id], references: [id])
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  // ─── Simulated clock (test orgs only) ─────────────────────────────────────────
  is_test            Boolean   @default(false) // test client → controllable clock
  sim_epoch          DateTime?                 // the simulated instant last set
  sim_anchor         DateTime?                 // real time when sim_epoch was set (ticking)
  sim_replayed_until DateTime?                 // simulated time engines have replayed up to

  members            OrganizationMember[]
  org_identity       OrgIdentity?
  culture_standards  CultureStandard[]
  departments        Department[]
  roles              Role[]
  system_roles       SystemRole[]
  employee_profiles  EmployeeProfile[]
  employee_import_batches EmployeeImportBatch[]
  department_import_batches DepartmentImportBatch[]
  role_import_batches      RoleImportBatch[]
  task_import_batches      TaskImportBatch[]
  learning_paths     LearningPath[]
  company_policies   CompanyPolicy[]
  announcements      Announcement[]
  announcement_reads AnnouncementRead[]
  bulletin_boards    BulletinBoard[]
  bulletin_posts     BulletinPost[]
  bulletin_comments  BulletinComment[]
  bulletin_reactions BulletinReaction[]
  knowledge_posts    KnowledgePost[]
  knowledge_comments KnowledgeComment[]
  knowledge_reactions KnowledgeReaction[]
  conversations      Conversation[]
  conversation_members ConversationMember[]
  messages           Message[]
  module_entitlements OrgModuleEntitlement[]

  @@map("organizations")
}

model OrganizationMember {
  id              String     @id @default(uuid())
  organization_id String
  user_id         String
  is_admin        Boolean    @default(false) // platform-admin flag — governs admin leaves ONLY, never feature access
  is_active       Boolean    @default(true)
  joined_at       DateTime   @default(now())

  organization Organization @relation(fields: [organization_id], references: [id])
  user         User         @relation(fields: [user_id], references: [id])

  @@unique([organization_id, user_id])
  @@map("organization_members")
}

model User {
  id              String   @id @default(uuid())
  name            String
  email           String
  password_hash   String
  is_super_admin  Boolean  @default(false)
  is_active       Boolean  @default(true)
  // Sliding-session refresh tokens are stored HASHED (sha256 hex), never raw —
  // a DB leak must not hand out usable sessions. `refresh_token` is the current
  // hash; `refresh_token_prev` is the immediately-previous hash, honoured only
  // until `refresh_token_prev_exp` (a short grace window) so a racing/concurrent
  // refresh from another tab isn't force-logged-out.
  refresh_token          String?
  refresh_token_prev     String?
  refresh_token_prev_exp DateTime?
  // Google Calendar OAuth refresh token for THIS user's own calendar. Stored
  // ENCRYPTED at rest (AES-256-GCM), never raw — a DB leak must not hand out a
  // live grant on someone's Google account. null = not connected. Each user
  // connects their own calendar; the token is global to the user (not per-org).
  google_refresh_token   String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization_memberships OrganizationMember[]
  employee_profiles        EmployeeProfile[]
  employee_import_batches  EmployeeImportBatch[] @relation("EmployeeImportedBy")
  department_import_batches DepartmentImportBatch[] @relation("DepartmentImportedBy")
  role_import_batches      RoleImportBatch[] @relation("RoleImportedBy")
  task_import_batches      TaskImportBatch[] @relation("TaskImportedBy")
  headed_departments       Department[]       @relation("DepartmentHead")
  reports_to_employees     EmployeeProfile[]  @relation("ReportingTo")
  announcements            Announcement[]
  announcement_reads       AnnouncementRead[]
  bulletin_boards          BulletinBoard[]
  bulletin_posts           BulletinPost[]
  bulletin_comments        BulletinComment[]
  bulletin_reactions       BulletinReaction[]
  knowledge_posts          KnowledgePost[]
  knowledge_comments       KnowledgeComment[]
  knowledge_reactions      KnowledgeReaction[]
  conversations            Conversation[]
  conversation_memberships ConversationMember[]
  sent_messages            Message[]          @relation("SentMessages")
  owned_goals              Goal[]             @relation("GoalOwner")
  goal_check_ins           GoalCheckIn[]      @relation("GoalCheckInAuthor")
  audit_logs               AuditLog[]
  organized_meetings       Meeting[]          @relation("MeetingOrganizer")
  meeting_attendances      MeetingAttendee[]  @relation("MeetingAttendeeUser")
  permission_overrides     UserPermissionOverride[]
  subject_overrides        UserSubjectOverride[]

  @@unique([email])
  @@map("users")
}

/// Short-lived password-reset requests. One row per active request per email;
/// the OTP is stored HASHED (bcrypt), never in plaintext. `reset_token` is minted
/// only after the OTP is verified and is single-use. Rows are disposable — the
/// newest un-consumed row for an email is the source of truth.
model PasswordReset {
  id          String    @id @default(uuid())
  email       String
  otp_hash    String
  reset_token String?
  attempts    Int       @default(0)
  expires_at  DateTime
  consumed_at DateTime?
  created_at  DateTime  @default(now())

  @@index([email])
  @@map("password_resets")
}

model OrgIdentity {
  id              String   @id @default(uuid())
  organization_id String   @unique
  vision          String?  @db.Text
  mission         String?  @db.Text
  purpose         String?  @db.Text
  values          Json?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id])

  @@map("org_identities")
}

model CultureStandard {
  id              String       @id @default(uuid())
  organization_id String
  title           String
  description     String       @db.Text
  type            BehaviorType
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id])

  @@map("culture_standards")
}

model Department {
  id                   String   @id @default(uuid())
  organization_id      String
  name                 String
  description          String?  @db.Text
  parent_department_id String?
  head_user_id         String?
  color                String?  // optional hex override for the org-chart node; null = inherit branch hue
  position_x           Float    @default(0)
  position_y           Float    @default(0)
  // Assignee-visibility: when false, members of this dept can assign to their direct
  // manager and below, but not above the manager. Default false = restrictive.
  assignee_allow_upward Boolean @default(false)
  // Assignee-visibility: when true, this department and ALL its descendant departments
  // are treated as one pool — every member can assign to every other member of the
  // subtree. The flag highest in the chain wins. Default false.
  assignee_unify_subtree Boolean @default(false)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  organization        Organization    @relation(fields: [organization_id], references: [id])
  parent_department   Department?     @relation("DepartmentHierarchy", fields: [parent_department_id], references: [id])
  child_departments   Department[]    @relation("DepartmentHierarchy")
  head_user           User?           @relation("DepartmentHead", fields: [head_user_id], references: [id])
  roles               Role[]
  employee_profiles   EmployeeProfile[]
  import_batch_id     String?
  import_batch        DepartmentImportBatch? @relation("DepartmentImportBatch", fields: [import_batch_id], references: [id], onDelete: SetNull)
  announcements       Announcement[]
  bulletin_boards     BulletinBoard[]
  knowledge_posts     KnowledgePost[]
  goals               Goal[]

  @@index([import_batch_id])
  @@map("departments")
}

model Role {
  id              String    @id @default(uuid())
  organization_id String
  department_id   String
  title           String
  job_description String?   @db.Text
  kra             Json?
  kpi             Json?
  level           RoleLevel @default(mid)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  organization      Organization      @relation(fields: [organization_id], references: [id])
  department        Department        @relation(fields: [department_id], references: [id])
  employee_profiles EmployeeProfile[]
  import_batch_id   String?
  import_batch      RoleImportBatch? @relation("RoleImportBatch", fields: [import_batch_id], references: [id], onDelete: SetNull)

  @@index([import_batch_id])
  @@map("roles")
}

model EmployeeProfile {
  id                   String         @id @default(uuid())
  organization_id      String
  user_id              String
  role_id              String // job role (title / designation)
  system_role_id       String? // access-rights bundle (System Role); null until assigned
  department_id        String
  reporting_to_user_id String?
  import_batch_id      String? // set when the profile was created via bulk import; enables guarded undo
  employee_code        String?
  date_of_joining      DateTime?
  date_of_birth        DateTime?
  marriage_date        DateTime?
  employment_type      EmploymentType @default(full_time)
  status               EmployeeStatus @default(active)
  created_at           DateTime       @default(now())
  updated_at           DateTime       @updatedAt

  organization         Organization             @relation(fields: [organization_id], references: [id])
  user                 User                     @relation(fields: [user_id], references: [id])
  role                 Role                     @relation(fields: [role_id], references: [id])
  system_role          SystemRole?              @relation(fields: [system_role_id], references: [id])
  department           Department               @relation(fields: [department_id], references: [id])
  reporting_to         User?                    @relation("ReportingTo", fields: [reporting_to_user_id], references: [id])
  import_batch         EmployeeImportBatch?     @relation(fields: [import_batch_id], references: [id], onDelete: SetNull)
  learning_assignments LearningPathAssignment[]
  policy_assignments   CompanyPolicyAssignment[]

  @@unique([organization_id, user_id])
  @@index([import_batch_id])
  @@map("employee_profiles")
}

// One bulk-import run. Kept permanently for Import History; `status` flips when undone.
// Undo is guarded: only rows still free of dependent data are removed (see EmployeesService.undoImport).
enum ImportBatchStatus {
  committed
  undone
  partially_undone
}

model EmployeeImportBatch {
  id                  String            @id @default(uuid())
  organization_id     String
  imported_by_user_id String
  file_name           String?
  total_rows          Int // rows submitted for commit
  created_count       Int // profiles actually created
  failed_count        Int // rows rejected at commit time
  status              ImportBatchStatus @default(committed)
  undo_summary        Json? // { undone: number, kept: [{ name, email, reason }] }
  created_at          DateTime          @default(now())
  undone_at           DateTime?

  organization Organization        @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  imported_by  User                @relation("EmployeeImportedBy", fields: [imported_by_user_id], references: [id])
  profiles     EmployeeProfile[]
  rows         EmployeeImportRow[]

  @@index([organization_id])
  @@map("employee_import_batches")
}

enum ImportRowResultStatus {
  created
  failed
}

// One submitted row of a bulk import, retained so a past batch can be reopened
// from Import History (detail view) and its failed / undo-removed rows can be
// re-exported for correction. Cascade-deleted with its batch.
model EmployeeImportRow {
  id              String                @id @default(uuid())
  batch_id        String
  row_num         Int // 1-based sheet row (header = row 1, first data row = 2)
  name            String?
  email           String?
  status          ImportRowResultStatus
  error           String? // failure reason at commit time (null when created)
  payload         Json // original cell values (BulkImportRowDto), for re-export
  created_user_id String? // user created for this row; null when the row failed
  created_at      DateTime              @default(now())

  batch EmployeeImportBatch @relation(fields: [batch_id], references: [id], onDelete: Cascade)

  @@index([batch_id])
  @@map("employee_import_rows")
}

model DepartmentImportBatch {
  id                  String            @id @default(uuid())
  organization_id     String
  imported_by_user_id String
  file_name           String?
  total_rows          Int
  created_count       Int
  failed_count        Int
  status              ImportBatchStatus @default(committed)
  undo_summary        Json?
  created_at          DateTime          @default(now())
  undone_at           DateTime?

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  imported_by  User         @relation("DepartmentImportedBy", fields: [imported_by_user_id], references: [id])
  departments  Department[] @relation("DepartmentImportBatch")

  @@index([organization_id])
  @@map("department_import_batches")
}

model RoleImportBatch {
  id                  String            @id @default(uuid())
  organization_id     String
  imported_by_user_id String
  file_name           String?
  total_rows          Int
  created_count       Int
  failed_count        Int
  status              ImportBatchStatus @default(committed)
  undo_summary        Json?
  created_at          DateTime          @default(now())
  undone_at           DateTime?

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  imported_by  User         @relation("RoleImportedBy", fields: [imported_by_user_id], references: [id])
  roles        Role[]       @relation("RoleImportBatch")

  @@index([organization_id])
  @@map("role_import_batches")
}

// A bulk task-import run. Mirrors EmployeeImportBatch: records what was submitted,
// how many tasks were created vs failed, and enough state for a guarded, window-
// limited undo (see TaskImportService.undoImport).
model TaskImportBatch {
  id                  String            @id @default(uuid())
  organization_id     String
  imported_by_user_id String
  file_name           String?
  total_rows          Int // rows submitted for commit
  created_count       Int // tasks actually created
  failed_count        Int // rows rejected at commit time
  status              ImportBatchStatus @default(committed)
  undo_summary        Json? // { undone: number, kept: [{ title, reason }] }
  created_at          DateTime          @default(now())
  undone_at           DateTime?

  organization Organization      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  imported_by  User              @relation("TaskImportedBy", fields: [imported_by_user_id], references: [id])
  tasks        Task[]
  rows         TaskImportRow[]

  @@index([organization_id])
  @@map("task_import_batches")
}

// One submitted row of a bulk task import, retained so a past batch can be reopened
// from Import History (detail view) and its failed / undo-removed rows re-exported
// for correction. Cascade-deleted with its batch.
model TaskImportRow {
  id              String                @id @default(uuid())
  batch_id        String
  row_num         Int // 1-based sheet row (header = row 1, first data row = 2)
  title           String?
  status          ImportRowResultStatus
  error           String? // failure reason at commit time (null when created)
  payload         Json // original cell values (BulkTaskImportRowDto), for re-export
  created_task_id String? // task created for this row; null when the row failed
  created_at      DateTime              @default(now())

  batch TaskImportBatch @relation(fields: [batch_id], references: [id], onDelete: Cascade)

  @@index([batch_id])
  @@map("task_import_rows")
}

model LearningPath {
  id                 String             @id @default(uuid())
  organization_id    String
  title              String
  description        String?            @db.Text
  thumbnail_url      String?
  status             LearningPathStatus @default(draft)
  mode               SequentialMode     @default(free_form)
  role_id            String?
  created_by_user_id String
  estimated_minutes  Int?
  created_at         DateTime           @default(now())
  updated_at         DateTime           @updatedAt

  organization Organization             @relation(fields: [organization_id], references: [id])
  items        LearningItem[]
  assignments  LearningPathAssignment[]

  @@index([organization_id, status, role_id])
  @@map("learning_paths")
}

model LearningItem {
  id                String      @id @default(uuid())
  path_id           String
  title             String
  description       String?     @db.Text
  content_type      ContentType
  content_url       String?
  content_body      String?     @db.Text
  order_index       Int         @default(0)
  estimated_minutes Int?
  is_required       Boolean     @default(true)
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt

  // ── Uploaded file (content_type = file). Stored privately in R2. ──
  file_name           String? // original filename, shown to learners + used on download
  file_mime           String?
  file_size_bytes     Int?
  storage_key         String? // R2 object key of the original upload
  preview_storage_key String? // R2 key of the converted preview PDF (office docs); null when the original is viewed directly
  preview_status      LearningPreviewStatus @default(none)
  // Course-decider's per-material choice. false = view-only (no download button,
  // watermarked, save/print/right-click suppressed).
  allow_download      Boolean               @default(true)
  // For url items: render the linked page inline in an iframe (auto-embed known
  // providers, fallback to open-in-new-tab if the site blocks framing) vs. a link button.
  embed_inline        Boolean               @default(false)

  path     LearningPath           @relation(fields: [path_id], references: [id], onDelete: Cascade)
  progress LearningItemProgress[]
  views    LearningItemView[]

  @@index([path_id, order_index])
  @@map("learning_items")
}

// One row per (learner, item): who opened a lesson, how many times, and when.
// Powers the "who accessed what" engagement analytics. Distinct from
// LearningItemProgress (which tracks completion) — a view is just an open.
model LearningItemView {
  id                  String   @id @default(uuid())
  organization_id     String
  path_id             String
  item_id             String
  employee_profile_id String
  user_id             String
  view_count          Int      @default(1)
  first_viewed_at     DateTime @default(now())
  last_viewed_at      DateTime @default(now())

  item LearningItem @relation(fields: [item_id], references: [id], onDelete: Cascade)

  @@unique([item_id, employee_profile_id])
  @@index([path_id])
  @@index([organization_id])
  @@map("learning_item_views")
}

model LearningPathAssignment {
  id                  String           @id @default(uuid())
  path_id             String
  employee_profile_id String
  assigned_by_user_id String
  assigned_at         DateTime         @default(now())
  due_date            DateTime?
  status              AssignmentStatus @default(not_started)
  completed_at        DateTime?

  path             LearningPath           @relation(fields: [path_id], references: [id])
  employee_profile EmployeeProfile        @relation(fields: [employee_profile_id], references: [id])
  item_progress    LearningItemProgress[]
  path_progress    LearningPathProgress?

  @@unique([path_id, employee_profile_id])
  @@index([employee_profile_id])
  @@map("learning_path_assignments")
}

model LearningItemProgress {
  id                  String           @id @default(uuid())
  assignment_id       String
  item_id             String
  employee_profile_id String
  status              AssignmentStatus @default(not_started)
  completion_type     CompletionType?
  started_at          DateTime?
  completed_at        DateTime?

  assignment LearningPathAssignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  item       LearningItem           @relation(fields: [item_id], references: [id], onDelete: Cascade)

  @@unique([assignment_id, item_id])
  @@index([employee_profile_id])
  @@map("learning_item_progress")
}

model LearningPathProgress {
  id                  String   @id @default(uuid())
  assignment_id       String   @unique
  employee_profile_id String
  path_id             String
  total_items         Int      @default(0)
  completed_items     Int      @default(0)
  progress_percent    Float    @default(0)
  last_activity_at    DateTime @default(now())

  assignment LearningPathAssignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)

  @@map("learning_path_progress")
}

// ─── Communication Layer ────────────────────────────────────────────────────

model Announcement {
  id                  String              @id @default(uuid())
  organization_id     String
  title               String
  body                String              @db.Text
  type                AnnouncementType    @default(announcement)
  scope               CommunicationScope  @default(company_wide)
  department_id       String?
  priority            AnnouncementPriority @default(normal)
  published_at        DateTime?
  expires_at          DateTime?
  created_by_user_id  String
  is_pinned           Boolean             @default(false)
  attachment_urls     Json?
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt

  organization Organization      @relation(fields: [organization_id], references: [id])
  department   Department?       @relation(fields: [department_id], references: [id])
  created_by   User              @relation(fields: [created_by_user_id], references: [id])
  reads        AnnouncementRead[]

  @@map("announcements")
}

model AnnouncementRead {
  id              String   @id @default(uuid())
  organization_id String
  announcement_id String
  user_id         String
  read_at         DateTime @default(now())

  organization Organization @relation(fields: [organization_id], references: [id])
  announcement Announcement @relation(fields: [announcement_id], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [user_id], references: [id])

  @@unique([announcement_id, user_id])
  @@map("announcement_reads")
}

model BulletinBoard {
  id                  String               @id @default(uuid())
  organization_id     String
  name                String
  description         String?              @db.Text
  scope               CommunicationScope   @default(company_wide)
  department_id       String?
  interaction_mode    BoardInteractionMode @default(comments_and_reactions)
  created_by_user_id  String
  is_active           Boolean              @default(true)
  created_at          DateTime             @default(now())
  updated_at          DateTime             @updatedAt

  organization Organization    @relation(fields: [organization_id], references: [id])
  department   Department?     @relation(fields: [department_id], references: [id])
  created_by   User            @relation(fields: [created_by_user_id], references: [id])
  posts        BulletinPost[]

  @@map("bulletin_boards")
}

model BulletinPost {
  id                  String   @id @default(uuid())
  organization_id     String
  bulletin_board_id   String
  title               String
  body                String   @db.Text
  attachment_urls     Json?
  is_pinned           Boolean  @default(false)
  created_by_user_id  String
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  organization   Organization       @relation(fields: [organization_id], references: [id])
  bulletin_board BulletinBoard      @relation(fields: [bulletin_board_id], references: [id], onDelete: Cascade)
  created_by     User               @relation(fields: [created_by_user_id], references: [id])
  comments       BulletinComment[]
  reactions      BulletinReaction[]

  @@map("bulletin_posts")
}

model BulletinComment {
  id                  String   @id @default(uuid())
  organization_id     String
  bulletin_post_id    String
  body                String   @db.Text
  created_by_user_id  String
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  organization  Organization @relation(fields: [organization_id], references: [id])
  bulletin_post BulletinPost @relation(fields: [bulletin_post_id], references: [id], onDelete: Cascade)
  created_by    User         @relation(fields: [created_by_user_id], references: [id])

  @@map("bulletin_comments")
}

model BulletinReaction {
