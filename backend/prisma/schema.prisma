// ─── Tickets ──────────────────────────────────────────────────────────────────

enum TicketStatusType {
  open
  assigned
  in_progress
  on_hold
  resolved
  closed_resolved
  closed_unresolved
}

enum TicketTemplateType {
  full
  simple
}

enum TicketReassignmentMode {
  assignee_only
  admin_manager_only
  both
}

// How a resolver group hands a new ticket to one of its members.
enum TicketAssignmentStrategy {
  round_robin // force-assign to the next member in rotation
  claim       // leave unassigned in the pool; any member can claim it
  manual      // leave unassigned for an admin/manager to assign
}

// Mirrors ChecklistAccessMode — gates who may pick a template when raising.
enum TicketTemplateAccessMode {
  everyone
  restricted
}

// Mirrors ChecklistAccessKind.
enum TicketTemplateAccessKind {
  department
  role
  user
  exclude_user
  exclude_role
}

enum TicketActivityAction {
  created
  assigned
  reassigned
  status_changed
  accepted
  resolved
  closed
  reopened
  escalated
  comment_added
  comment_deleted
  proof_attached
  checklist_updated
  rating_submitted
  deleted
  sla_breached
  confirmation_requested
  raiser_confirmed
  rejected
  transferred
  put_on_hold
  resumed
  first_responded
  response_breached
  claimed
}

model TicketMaster {
  id                          String                 @id @default(uuid())
  organization_id             String                 @unique
  ticket_creation_roles       Json                   @default("[\"org_admin\",\"hr_manager\",\"employee\"]")
  reassignment_mode           TicketReassignmentMode @default(both)
  require_raiser_confirmation Boolean                @default(false)
  enable_rating               Boolean                @default(false)
  default_escalation_levels   Int                    @default(2)
  // Org-wide first-response target (hours). null = no first-response clock by default.
  default_response_sla_hours  Int?
  // Gap between successive auto-escalation tiers, measured from resolution-SLA breach.
  escalation_interval_hours   Int                    @default(24)
  // Who may reopen a closed ticket.
  allow_requester_reopen      Boolean                @default(true)
  allow_assignee_reopen       Boolean                @default(true)
  created_at                  DateTime               @default(now())
  updated_at                  DateTime               @updatedAt

  @@map("ticket_masters")
}

model TicketType {
  id                         String   @id @default(uuid())
  organization_id            String
  name                       String
  description                String?  @db.Text
  color                      String
  icon                       String
  default_sla_days           Int
  default_response_sla_hours Int?
  auto_assign_user_id        String?
  auto_assign_role           String?
  resolver_group_id          String?
  is_active                  Boolean  @default(true)
  order_index                Int      @default(0)
  created_at                 DateTime @default(now())
  updated_at                 DateTime @updatedAt

  resolver_group TicketResolverGroup? @relation(fields: [resolver_group_id], references: [id])
  categories     TicketCategory[]
  tickets        Ticket[]
  templates      TicketTemplate[]

  @@map("ticket_types")
}

model TicketCategory {
  id                         String   @id @default(uuid())
  organization_id            String
  name                       String
  description                String?  @db.Text
  color                      String
  ticket_type_id             String?
  default_sla_days           Int?
  default_response_sla_hours Int?
  auto_assign_user_id        String?
  auto_assign_role           String?
  resolver_group_id          String?
  visible_to_departments     Json     @default("[]")
  visible_to_roles           Json     @default("[]")
  is_active                  Boolean  @default(true)
  created_at                 DateTime @default(now())
  updated_at                 DateTime @updatedAt

  ticket_type    TicketType?          @relation(fields: [ticket_type_id], references: [id])
  resolver_group TicketResolverGroup? @relation(fields: [resolver_group_id], references: [id])
  tickets        Ticket[]
  templates      TicketTemplate[]

  @@map("ticket_categories")
}

model TicketPriority {
  id              String   @id @default(uuid())
  organization_id String
  label           String
  color           String
  sla_days        Int?
  order_index     Int      @default(0)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  tickets   Ticket[]
  templates TicketTemplate[]

  @@map("ticket_priorities")
}

model TicketTemplate {
  id                   String                   @id @default(uuid())
  organization_id      String
  name                 String
  template_type        TicketTemplateType       @default(simple)
  ticket_type_id       String?
  category_id          String?
  priority_id          String?
  resolver_group_id    String?
  // Department this template is grouped under in the raise-ticket catalog.
  department_id        String?
  // Optional free-text grouping label (used when no department grouping fits).
  group_label          String?
  title_template       String
  description_template String?                  @db.Text
  auto_assign_user_id  String?
  auto_assign_role     String?
  sla_days             Int?
  response_sla_hours   Int?
  // When true the raiser cannot change the pre-filled priority.
  lock_priority        Boolean                  @default(false)
  checklist_items      Json                     @default("[]")
  // Who may pick this template when raising a ticket.
  access_mode          TicketTemplateAccessMode @default(everyone)
  is_active            Boolean                  @default(true)
  created_by_user_id   String
  created_at           DateTime                 @default(now())
  updated_at           DateTime                 @updatedAt

  ticket_type    TicketType?                  @relation(fields: [ticket_type_id], references: [id])
  category       TicketCategory?              @relation(fields: [category_id], references: [id])
  priority       TicketPriority?              @relation(fields: [priority_id], references: [id])
  resolver_group TicketResolverGroup?         @relation(fields: [resolver_group_id], references: [id])
  access_rules   TicketTemplateAccessRule[]
  tickets        Ticket[]

  @@map("ticket_templates")
}

model TicketStatus {
  id              String           @id @default(uuid())
  organization_id String
  label           String
  type            TicketStatusType
  color           String
  order_index     Int              @default(0)
  is_default      Boolean          @default(false)
  is_active       Boolean          @default(true)
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  tickets Ticket[]

  @@map("ticket_statuses")
}

model Ticket {
  id                           String    @id @default(uuid())
  organization_id              String
  ticket_number                String
  title                        String
  description                  String?   @db.Text
  ticket_type_id               String
  category_id                  String?
  priority_id                  String?
  status_id                    String
  template_id                  String?
  raised_by_user_id            String
  assigned_to_user_id          String?
  assigned_at                  DateTime?
  resolver_group_id            String?
  sla_days                     Int
  sla_due_at                   DateTime
  sla_breached                 Boolean   @default(false)
  // First-response clock (null hours = no response SLA on this ticket).
  response_sla_hours           Int?
  response_due_at              DateTime?
  responded_at                 DateTime?
  response_breached            Boolean   @default(false)
  // On-hold pauses the resolution clock; on resume sla_due_at is pushed forward.
  on_hold                      Boolean   @default(false)
  hold_since                   DateTime?
  total_hold_seconds           Int       @default(0)
  reopen_count                 Int       @default(0)
  accepted_at                  DateTime?
  resolved_at                  DateTime?
  closed_at                    DateTime?
  resolution_note              String?   @db.Text
  requires_raiser_confirmation Boolean   @default(false)
  raiser_confirmed_at          DateTime?
  rating                       Int?
  rating_comment               String?   @db.Text
  rated_at                     DateTime?
  proof_required               Boolean   @default(false)
  proof_url                    String?
  is_deleted                   Boolean   @default(false)
  deleted_by_user_id           String?
  deleted_at                   DateTime?
  deletion_reason              String?   @db.Text
  created_at                   DateTime  @default(now())
  updated_at                   DateTime  @updatedAt

  ticket_type   TicketType      @relation(fields: [ticket_type_id], references: [id])
  category      TicketCategory? @relation(fields: [category_id], references: [id])
  priority      TicketPriority? @relation(fields: [priority_id], references: [id])
  status        TicketStatus    @relation(fields: [status_id], references: [id])
  template      TicketTemplate? @relation(fields: [template_id], references: [id])
  checklist     TicketChecklist[]
  escalations   TicketEscalation[]
  activity_logs TicketActivityLog[]
  comments      TicketComment[]

  @@unique([organization_id, ticket_number])
  @@map("tickets")
}

