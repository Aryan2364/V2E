// ─── Holiday & Working Days ───────────────────────────────────────────────────

enum HolidayOnTaskAction {
  skip_create
  create_anyway
  move_to_prev_working_day
  move_to_next_working_day
}

enum HolidayPriorityLevel {
  individual_first
  department_first
  org_first
}

enum HolidayType {
  national
  company
  regional
  team
  personal
  leave
}

enum HolidayStatus {
  active
  pending_review
}

enum HolidayEntityType {
  task
  recurring_task
  workflow_step
  ticket
}

model HolidayMaster {
  id                            String                @id @default(uuid())
  organization_id               String                @unique
  country_code                  String?
  holiday_on_task_action        HolidayOnTaskAction   @default(move_to_next_working_day)
  priority_level                HolidayPriorityLevel  @default(individual_first)
  pending_review_deadline_days  Int                   @default(7)
  auto_apply_if_not_reviewed    Boolean               @default(false)
  created_at                    DateTime              @default(now())
  updated_at                    DateTime              @updatedAt

  @@map("holiday_masters")
}

model OrgWorkingDays {
  id              String   @id @default(uuid())
  organization_id String   @unique
  working_days    Json     @default("[1,2,3,4,5]")
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@map("org_working_days")
}

model OrgHoliday {
  id                   String        @id @default(uuid())
  organization_id      String
  name                 String
  date                 DateTime      @db.Date
  end_date             DateTime?     @db.Date
  type                 HolidayType
  source               String?
  is_recurring_yearly  Boolean       @default(false)
  description          String?       @db.Text
  status               HolidayStatus @default(active)
  year                 Int
  created_at           DateTime      @default(now())
  updated_at           DateTime      @updatedAt

  opt_outs OrgHolidayOptOut[]

  @@map("org_holidays")
}

/**
 * Department-level suppression of an ORG holiday. Org holidays are a baseline that
 * cascades to every department; this row removes one for a department. The remover
 * chooses the reach via `applies_to_subtree`:
 *   - false → suppress at this department only (children still observe it).
 *   - true  → suppress at this department AND all its descendants (parent's call is
 *             authoritative; a descendant cannot re-add it).
 * Resolution: an org holiday is suppressed for dept D if any anchor A in D's ancestor
 * chain (D included) has `A === D || applies_to_subtree`. Reversible (delete the row).
 */
model OrgHolidayOptOut {
  id                   String   @id @default(uuid())
  organization_id      String
  org_holiday_id       String
  department_id        String // the department that removed it (anchor)
  applies_to_subtree   Boolean  @default(true)
  opted_out_by_user_id String
  created_at           DateTime @default(now())

  holiday OrgHoliday @relation(fields: [org_holiday_id], references: [id], onDelete: Cascade)

  @@unique([org_holiday_id, department_id])
  @@index([organization_id, department_id])
  @@map("org_holiday_opt_outs")
}

model DepartmentWorkingDays {
  id              String   @id @default(uuid())
  organization_id String
  department_id   String
  working_days    Json     @default("[1,2,3,4,5]")
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@unique([organization_id, department_id])
  @@map("department_working_days")
}

model DepartmentHoliday {
  id                  String        @id @default(uuid())
  organization_id     String
  // The ORIGIN department — where the holiday was created. It is the single
  // source row; descendants inherit it by reference (see DepartmentHolidayTarget),
  // never by copy, so editing this row updates every department it cascaded to.
  department_id       String
  name                String
  date                DateTime      @db.Date
  end_date            DateTime?     @db.Date
  type                HolidayType
  is_recurring_yearly Boolean       @default(false)
  description         String?       @db.Text
  status              HolidayStatus @default(active)
  year                Int
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt

  targets  DepartmentHolidayTarget[]
  opt_outs DepartmentHolidayOptOut[]

  @@map("department_holidays")
}

/**
 * Cascade reach of a department holiday: one row per descendant department the
 * holiday applies to (the "checked department list" from the cascade control).
 * The origin department is implicit and never stored here. Membership alone
 * decides inheritance — there is no All/Some/None label; it is derived from the
 * set. Deleting the holiday removes its targets.
 */
model DepartmentHolidayTarget {
  id              String   @id @default(uuid())
  organization_id String
  holiday_id      String
  department_id   String // a descendant of the holiday's origin department
  created_at      DateTime @default(now())

  holiday DepartmentHoliday @relation(fields: [holiday_id], references: [id], onDelete: Cascade)

  @@unique([holiday_id, department_id])
  @@index([organization_id, department_id])
  @@map("department_holiday_targets")
}

/**
 * Local opt-out (detach) of an inherited holiday, anchored at a department.
 * It suppresses the holiday for that department AND its descendants only —
 * resolution walks ancestors and drops a holiday whose path carries an opt-out,
 * so the effect flows DOWN, never up or sideways. Reversible (delete the row).
 */
model DepartmentHolidayOptOut {
  id                   String   @id @default(uuid())
  organization_id      String
  holiday_id           String
  department_id        String // the department that opted out (anchor of the detach)
  opted_out_by_user_id String
  created_at           DateTime @default(now())

  holiday DepartmentHoliday @relation(fields: [holiday_id], references: [id], onDelete: Cascade)

  @@unique([holiday_id, department_id])
  @@index([organization_id, department_id])
  @@map("department_holiday_opt_outs")
}

model IndividualWorkingDays {
  id              String    @id @default(uuid())
  organization_id String
  user_id         String
  working_days    Json      @default("[1,2,3,4,5]")
  effective_from  DateTime  @db.Date
  effective_to    DateTime? @db.Date
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  @@map("individual_working_days")
}

model IndividualHoliday {
  id                  String      @id @default(uuid())
  organization_id     String
  user_id             String
  name                String
  date                DateTime    @db.Date
  type                HolidayType
  is_recurring_yearly Boolean     @default(false)
  description         String?     @db.Text
  year                Int
  created_at          DateTime    @default(now())
  updated_at          DateTime    @updatedAt

  @@map("individual_holidays")
}

enum HolidayOptOutSource {
  org
  department
}

/**
 * Individual-level suppression of an inherited holiday. An employee's effective set is
 * their department's effective set (org baseline + dept holidays − dept opt-outs) plus
 * personal holidays; this row removes one inherited holiday for that user only. The
 * holiday may originate at the org or a department, so `holiday_source` discriminates and
 * `holiday_id` references the corresponding row (no FK — cross-type; orphans are cleaned
 * up when the source holiday is deleted). Reversible (delete the row).
 */
model IndividualHolidayOptOut {
  id                   String              @id @default(uuid())
  organization_id      String
  user_id              String
  holiday_source       HolidayOptOutSource
  holiday_id           String
  opted_out_by_user_id String
  created_at           DateTime            @default(now())

  @@unique([user_id, holiday_source, holiday_id])
  @@index([organization_id, user_id])
  @@map("individual_holiday_opt_outs")
}

