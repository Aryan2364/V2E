// ─── Task Management Layer ──────────────────────────────────────────────────

enum TaskQuadrant {
  Q1
  Q2
  Q3
  Q4
}

enum TaskType {
  one_time
  recurring
}

enum CompletionMode {
  all_must_complete
  any_can_complete
}

// Who may view a proof-of-completion file. `private` = uploader + the assigner
// (task creator) + org admins only; `everyone` = anyone who can view the task.
enum ProofVisibility {
  private
  everyone
}

// How a TERMINAL task landed against its deadline. Null while the task is open
// (open timing is derived live from is_overdue). Set once when the task closes and
// never recomputed, so it never goes stale. `incomplete` = closed unsuccessfully
// (a terminal `incomplete` status, e.g. a recurring task that was never done).
enum CompletionTiming {
  early
  on_time
  late
  partial
  incomplete
}

enum ReminderRecurrence {
  one_time
  yearly
}

enum ReminderType {
  assignee
  assigner
  cc
}

enum TaskActionType {
  created
  edited
  assigned
  reassigned
  status_changed
  completed
  marked_incomplete
  part_flagged_incomplete
  part_flag_cleared
  reopened
  proof_attached
  checklist_updated
  checklist_item_skipped // an assignee marked a checklist item "can't do" with a reason
  checklist_item_overridden // the assigner marked an item done for everyone
  checklist_item_challenged // the assigner reopened a person's part to re-do a checklist item
  escalated
  reminder_sent
  deleted
  comment_added
  comment_deleted
  file_attached
}

enum RecurringScheduleType {
  daily
  weekly
  monthly
  yearly
}

enum RecurringEndCondition {
  never
  on_date
  after_n
}

enum RecurringAccessKind {
  grant
  revoke
}

enum RecurringAccessLevel {
  view
  edit
}

// All task tables use plain string IDs for cross-module references
// (no FK constraints to Organization/User/Department tables)
// This allows extraction as a standalone microservice.

model TaskMaster {
  id                          String   @id @default(uuid())
  organization_id             String   @unique
  task_creation_roles         Json     @default("[\"org_admin\",\"hr_manager\",\"employee\"]")
  task_edit_roles             Json     @default("[\"org_admin\",\"hr_manager\"]")
  task_delete_roles           Json     @default("[\"org_admin\"]")
  default_reminder_days_before Int     @default(1)
  default_reminder_frequency  String   @default("once")
  reopen_window_minutes       Int      @default(5)
  escalation_levels           Int      @default(2)
  archive_view_roles          Json     @default("[\"org_admin\"]")
  // Legacy base-mode fields — retained for rollback/reference; no longer read by the
  // resolver (base default is now fixed Hierarchy+Department, modulated by the per-dept
  // upward switch). See AssigneeVisibilityService.
  assignee_visibility_mode         String   @default("hierarchy_and_dept")
  assignee_custom_rules            Json?
  assignee_visibility_config_roles Json     @default("[\"org_admin\",\"hr_manager\"]")
  // New assignee-visibility model:
  assignee_master_override         Boolean  @default(false)
  assignee_full_visibility_roles   Json     @default("[\"org_admin\",\"hr_manager\"]")
  assignee_full_visibility_users   Json     @default("[]")
  created_at                  DateTime @default(now())
  updated_at                  DateTime @updatedAt

  @@map("task_masters")
}

// ─── Leave (employee availability) ───────────────────────────────────────────────
// A dated leave record. "On leave on date D" is computed by checking for an EFFECTIVE
// leave covering D (see LeaveService.isEffective): approved, pending, self_declared, or
// rejected-but-overridden. Availability is intentionally DECOUPLED from approval — a
// rejected-then-overridden or self-declared leave still makes the person unavailable, it
// is just flagged. Leave never removes a name from the assignee picker (only an INACTIVE
// employment status does); it only annotates and warns.
model Leave {
  id                 String      @id @default(uuid())
  organization_id    String
  user_id            String // the employee who is on leave
  start_date         DateTime // inclusive, date-only (midnight)
  end_date           DateTime // inclusive, date-only (midnight)
  reason             String?     @db.Text
  state              LeaveState  @default(pending)
  origin             LeaveOrigin @default(requested)
  overridden         Boolean     @default(false) // taken despite a rejection
  decided_by_user_id String?
  decided_at         DateTime?
  decision_note      String?
  created_by_user_id String // usually the employee; an admin may create on their behalf
  created_at         DateTime    @default(now())
  updated_at         DateTime    @updatedAt

  @@index([organization_id, user_id, start_date, end_date])
  @@index([organization_id, state])
  @@map("leaves")
}

// Per-org leave policy (one row per org — mirrors TaskMaster/HolidayMaster).
model LeaveMaster {
  id                  String   @id @default(uuid())
  organization_id     String   @unique
  // self_mark | manager | approvers | manager_or_approvers
  approval_mode       String   @default("manager")
  approver_user_ids   Json     @default("[]") // explicitly named approvers (no HR role exists)
  any_one_can_approve Boolean  @default(true)
  allow_override      Boolean  @default(true) // may an employee self-declare / override a rejection
  recurring_notice_days Int    @default(3) // look-ahead lead time for recurring-task leave warnings
  config_manage_roles Json     @default("[\"org_admin\"]") // who may edit these rules
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@map("leave_masters")
}

// ─── Assignee Visibility (who appears in the assign-to / CC picker) ──────────────

enum BridgeDepth {
  head_senior // target dept head + roles with level senior/lead/head
  whole_dept // everyone in the target dept
}

// One-directional: members of from_department may additionally assign into to_department.
model AssigneeCrossDeptBridge {
  id                 String      @id @default(uuid())
  organization_id    String
  from_department_id String
  to_department_id   String
  depth              BridgeDepth @default(head_senior)
  // When true the bridge also reaches every descendant department of to_department
  // (at the same depth), so a single bridge can cover a whole sub-tree.
  include_sub_departments Boolean @default(false)
  created_by         String?
  created_at         DateTime    @default(now())

  @@unique([organization_id, from_department_id, to_department_id])
  @@index([organization_id, from_department_id])
  @@map("assignee_cross_dept_bridges")
}

// The most-granular layer: a per-employee manual override applied on top of the live
// rules. `full_visibility` makes the employee see everyone; `added`/`removed` are a sticky
// delta (final = (rule base ∪ added) − removed, self always pinned). A removal persists
// even if a rule later re-includes the person, until cleared. References are plain ids.
model EmployeeAssigneeManualOverride {
  id               String   @id @default(uuid())
  organization_id  String
  employee_user_id String
  added_user_ids   Json     @default("[]")
  removed_user_ids Json     @default("[]")
  created_by       String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@unique([organization_id, employee_user_id])
  @@index([organization_id])
  @@map("employee_assignee_manual_overrides")
}

// Audit trail for every assignee-visibility change.
model AssigneeVisibilityAuditLog {
  id              String   @id @default(uuid())
  organization_id String
  actor_user_id   String
  action          String
  target          Json?
  before          Json?
  after           Json?
  created_at      DateTime @default(now())

  @@index([organization_id, created_at])
  @@map("assignee_visibility_audit_logs")
}

model TaskCategory {
  id                    String   @id @default(uuid())
  organization_id       String
  name                  String
  description           String?
  color                 String   @default("#2563EB")
  created_by_user_id    String
  visible_to_departments Json    @default("[]")
  visible_to_roles      Json     @default("[]")
  is_active             Boolean  @default(true)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  tasks Task[]

  @@map("task_categories")
}

model TaskPriority {
  id              String   @id @default(uuid())
  organization_id String
  label           String
  color           String   @default("#2563EB")
  order_index     Int      @default(0)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  tasks Task[]

  @@map("task_priorities")
}

model TaskStatus {
  id              String   @id @default(uuid())
  organization_id String
  label           String
  type            String
  color           String   @default("#2563EB")
  order_index     Int      @default(0)
  is_default      Boolean  @default(false)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  tasks           Task[]
  assignee_tracks TaskAssignee[]

  @@map("task_statuses")
}

model Task {
  id                   String         @id @default(uuid())
  organization_id      String
  title                String
  description          String?        @db.Text
  category_id          String?
  priority_id          String?
  status_id            String
  quadrant             TaskQuadrant   @default(Q2)
  type                 TaskType       @default(one_time)
  created_by_user_id   String
  department_id        String?
  completion_mode      CompletionMode @default(any_can_complete)
  proof_required       Boolean        @default(false)
  // Allowed proof file extensions (lowercase, no dot). Empty = anything allowed.
  proof_allowed_extensions String[]   @default([])
  is_deleted           Boolean        @default(false)
  deleted_by_user_id   String?
  deleted_at           DateTime?
  deletion_reason      String?        @db.Text
  reopened_at          DateTime?
  reopen_expires_at    DateTime?
  deadline             DateTime?
  is_overdue           Boolean        @default(false) // persisted by the auto-overdue sweep (mirrors Ticket.sla_breached)
  overdue_at           DateTime?      // business time the task crossed its deadline
  completed_at         DateTime?      // when the task reached a terminal `completed` OR `incomplete` status
  completion_timing    CompletionTiming? // early/on_time/late vs deadline, set once at completion
  // Why the task was closed unsuccessfully (terminal `incomplete`). Required when
  // marking a task Incomplete; cleared on reopen. `completed_by_user_id` doubles as
  // "who closed it" for both the completed and incomplete terminal transitions.
  incomplete_reason    String?        @db.Text
  // Attribution for the shared-status ("any can complete") flow: who last moved the
  // shared status, and who actually closed the task. Powers "changed by X" / "Completed by X".
  status_actor_user_id String?
  completed_by_user_id String?
  recurring_template_id     String?
  // Date-only stamp of the day this instance was spawned from its recurring
  // template. Paired with a unique index below so the DB physically rejects a
  // second spawn of the same template on the same day — the race-safe guard the
  // scheduler's count-then-create check cannot provide on its own. NULL for every
  // non-recurring task (NULLs are distinct in a Postgres unique index).
  recurring_spawn_date      DateTime? @db.Date
  workflow_instance_step_id String?
  goal_id              String?        // links a task to a QUARTERLY goal (initiative)
  // Set when the task was created via bulk import; enables the guarded undo.
  import_batch_id      String?
  created_at           DateTime       @default(now())
  updated_at           DateTime       @updatedAt

  category   TaskCategory?   @relation(fields: [category_id], references: [id])
  priority   TaskPriority?   @relation(fields: [priority_id], references: [id])
  status     TaskStatus      @relation(fields: [status_id], references: [id])
  goal       Goal?           @relation(fields: [goal_id], references: [id])
  import_batch TaskImportBatch? @relation(fields: [import_batch_id], references: [id], onDelete: SetNull)
  assignees  TaskAssignee[]
  checklist  TaskChecklist[]
  reminders  TaskReminder[]
  escalations TaskEscalation[]
  activity_logs TaskActivityLog[]
  comments   TaskComment[]
  attachments TaskAttachment[]
  views      TaskView[]

  @@unique([recurring_template_id, recurring_spawn_date], map: "tasks_recurring_template_day_unique")
  @@index([goal_id])
  @@index([organization_id])
  @@index([created_by_user_id])
  @@index([department_id])
  @@index([import_batch_id])
  @@map("tasks")
}

// Per-user "last opened" marker for a task. Drives the unread-comment count on the
// task list: comments created after `last_viewed_at` (and not authored by the viewer)
// are considered unread. Upserted whenever a user opens the task detail.
model TaskView {
  id              String   @id @default(uuid())
  organization_id String
  task_id         String
  user_id         String
  last_viewed_at  DateTime @default(now())

  task Task @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@unique([task_id, user_id])
  @@index([user_id])
  @@index([organization_id])
  @@map("task_views")
}

model TaskAssignee {
  id              String    @id @default(uuid())
  organization_id String
  task_id         String
  user_id         String
  // Per-person status track, used only in `all_must_complete` mode: each assignee
  // drives their own open-state status. Null → treat as the org's not_started status.
  // In `any_can_complete` mode this stays null; the task carries one shared status.
  status_id       String?
  is_completed    Boolean   @default(false)
  completed_at    DateTime?
  // Per-person "I can't finish my part" flag (all_must_complete mode). The part stays
  // OPEN but visibly flagged with a required reason; the task never auto-completes while
  // any part is flagged, so the creator/admin decides whether to close the whole task
  // Incomplete or reassign. Cleared when the person completes their part or on reopen.
  cannot_complete        Boolean   @default(false)
  cannot_complete_reason String?   @db.Text
  cannot_complete_at     DateTime?
  is_cc           Boolean   @default(false)
  created_at      DateTime  @default(now())

  task   Task        @relation(fields: [task_id], references: [id], onDelete: Cascade)
  status TaskStatus? @relation(fields: [status_id], references: [id])

  @@unique([task_id, user_id])
  @@index([user_id])
  @@index([organization_id])
  @@map("task_assignees")
}

// A checklist item is the shared DEFINITION (title/group/order). HOW it is "done"
// depends on the task's completion mode, mirroring how the task itself tracks status:
//   - any_can_complete / single assignee → ONE shared tick. `is_completed` +
//     `completed_by_user_id`/`completed_at` carry it (first person to tick owns it;
//     anyone may untick). Attribution is who last ticked it.
//   - all_must_complete → PER-PERSON. `is_completed` is ignored; each assignee's
//     own done/skip lives in `TaskChecklistItemState` (one row per person). The
//     item gates that person's Complete: they can't finish their part until every
//     item is done OR skipped-with-reason for them.
model TaskChecklist {
  id              String   @id @default(uuid())
  organization_id String
  task_id         String
  title           String
  group_title     String? // section label when a task carries multiple checklists; null = single ungrouped list
  is_completed    Boolean  @default(false) // shared-mode tick only (any_can_complete / single)
  cant_do         Boolean  @default(false) // shared-mode "can't do" — an item that genuinely can't be done
  cant_do_reason  String?  @db.Text // required when cant_do; shown to everyone
  completed_by_user_id String? // shared-mode: who last ticked/flagged it (attribution)
  completed_at    DateTime? // shared-mode: when it was last ticked/flagged
  order_index     Int      @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  task   Task                     @relation(fields: [task_id], references: [id], onDelete: Cascade)
  states TaskChecklistItemState[]

  @@index([task_id])
  @@index([organization_id])
  @@map("task_checklists")
}

// One assignee's state for one checklist item (all_must_complete mode only). Absence
// of a row = Not started for that person. `done` counts toward their gate; `skipped`
// also satisfies the gate but REQUIRES a reason (a step that genuinely can't be done).
// An assigner "mark done for everyone" writes a `done` row per assignee with
// `is_override = true` and `marked_by_user_id` = the assigner.
model TaskChecklistItemState {
  id                String             @id @default(uuid())
  organization_id   String
  checklist_id      String // the shared item definition (TaskChecklist)
  task_id           String // denormalized for scoping + cheap task-wide reads
  user_id           String // the assignee this state belongs to
  state             ChecklistItemState
  reason            String?            @db.Text // required when state = skipped
  is_override       Boolean            @default(false) // set by the assigner's "done for all"
  marked_by_user_id String // who set it (== user_id normally; == assigner on override)
  marked_at         DateTime           @default(now())
  updated_at        DateTime           @updatedAt

  checklist TaskChecklist @relation(fields: [checklist_id], references: [id], onDelete: Cascade)

  @@unique([checklist_id, user_id])
  @@index([task_id])
  @@index([user_id])
  @@index([organization_id])
  @@map("task_checklist_item_states")
}

enum ChecklistItemState {
  done
  skipped
}

model TaskChecklistTemplate {
  id                 String              @id @default(uuid())
  organization_id    String
  name               String
  created_by_user_id String
  items              Json                @default("[]")
  access_mode        ChecklistAccessMode @default(everyone)
  is_active          Boolean             @default(true)
  import_batch_id    String? // set when created via bulk import; enables guarded undo
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt

  access_rules ChecklistTemplateAccessRule[]
  import_batch ChecklistTemplateImportBatch? @relation(fields: [import_batch_id], references: [id], onDelete: SetNull)

  @@index([import_batch_id])
  @@map("task_checklist_templates")
}

// One bulk-import run of checklist templates. Kept for Import History; `status`
// flips when undone. Undo deletes the batch's still-inactive templates and keeps
// any the user has since activated (see ChecklistImportService.undoImport).
model ChecklistTemplateImportBatch {
  id                  String            @id @default(uuid())
  organization_id     String
  imported_by_user_id String
  file_name           String?
  total_rows          Int // checklist groups submitted for commit
  created_count       Int // templates actually created
  failed_count        Int // groups rejected at commit time
  status              ImportBatchStatus @default(committed)
  undo_summary        Json? // { undone: number, kept: [{ name, reason }] }
  created_at          DateTime          @default(now())
  undone_at           DateTime?

  templates TaskChecklistTemplate[]

  @@index([organization_id])
  @@map("checklist_template_import_batches")
}

enum ChecklistAccessMode {
  everyone
  restricted
}

enum ChecklistAccessKind {
  department
  role
  user
  exclude_user // a person revoked from the dynamic department/role grants
  exclude_role // a whole role revoked from the dynamic department grants
}

model ChecklistTemplateAccessRule {
  id                      String              @id @default(uuid())
  organization_id         String
  template_id             String
  kind                    ChecklistAccessKind
  department_id           String? // when kind = department
  include_sub_departments Boolean             @default(true) // cascade opt-out
  role_id                 String? // when kind = role (dept-scoped Role.id)
  user_id                 String? // when kind = user
  created_at              DateTime            @default(now())

  template TaskChecklistTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@index([organization_id, template_id])
  @@map("checklist_template_access_rules")
}

model TaskReminder {
  id              String       @id @default(uuid())
  organization_id String
  task_id         String
  remind_at       DateTime
  type            ReminderType @default(assignee) // who is notified: assignee | assigner | cc
  offset_days     Int? // relative provenance: days-before-deadline this was set from (null = absolute date)
  recurrence      ReminderRecurrence @default(one_time) // yearly re-arms after firing (until the task closes)
  is_sent         Boolean      @default(false)
  created_at      DateTime     @default(now())

  task Task @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@index([task_id])
  @@index([organization_id])
  @@map("task_reminders")
}

model TaskEscalation {
  id                   String    @id @default(uuid())
  organization_id      String
  task_id              String
  level                Int       @default(1)
  escalate_to_user_id  String
  escalated_at         DateTime?
  is_acknowledged      Boolean   @default(false)
  acknowledged_at      DateTime?
  is_active            Boolean   @default(true)
  created_at           DateTime  @default(now())

  task Task @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@index([task_id])
  @@index([organization_id])
  @@index([escalate_to_user_id])
  @@map("task_escalations")
}

model TaskActivityLog {
  id                   String         @id @default(uuid())
  organization_id      String
  task_id              String
  performed_by_user_id String
  action               TaskActionType
  metadata             Json?
  created_at           DateTime       @default(now())

  task Task @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@index([task_id])
  @@index([organization_id])
  @@map("task_activity_logs")
}

model TaskComment {
  id                  String    @id @default(uuid())
  organization_id     String
  task_id             String
  user_id             String
  body                String    @db.Text
  attachment_urls     Json?
  reply_to_comment_id String?
  is_deleted          Boolean   @default(false)
  deleted_at          DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  task             Task          @relation(fields: [task_id], references: [id], onDelete: Cascade)
  reply_to_comment TaskComment?  @relation("CommentReplies", fields: [reply_to_comment_id], references: [id])
  replies          TaskComment[] @relation("CommentReplies")
  attachments      TaskAttachment[]

  @@index([task_id])
  @@index([organization_id])
  @@map("task_comments")
}

// Real uploaded documents stored in object storage (Cloudflare R2), attached to a
// task itself or to one of its comments. The bytes live in R2 under `storage_key`;
// this row is the metadata + access record. Cascade-deletes with its task/comment so
// orphaned rows never linger (the R2 object is purged by the service on delete).
model TaskAttachment {
  id                  String    @id @default(uuid())
  organization_id     String
  task_id             String
  comment_id          String? // set when attached to a comment rather than the task itself
  file_name           String // original filename, shown to users and used on download
  mime_type           String
  size_bytes          Int
  storage_key         String // object key within the R2 bucket
  uploaded_by_user_id String // also the proof OWNER when is_proof
  // Proof-of-completion flag + who may see it. uploaded_by_user_id is the owner.
  is_proof            Boolean          @default(false)
  proof_visibility    ProofVisibility? // null for non-proof rows
  is_deleted          Boolean   @default(false)
  deleted_at          DateTime?
  created_at          DateTime  @default(now())

  task    Task         @relation(fields: [task_id], references: [id], onDelete: Cascade)
  comment TaskComment? @relation(fields: [comment_id], references: [id], onDelete: Cascade)

  @@index([task_id])
  @@index([task_id, is_proof])
  @@index([comment_id])
  @@index([organization_id])
  @@map("task_attachments")
}

model RecurringTemplate {
  id                     String   @id @default(uuid())
  organization_id        String
  title                  String
  description            String?  @db.Text
  quadrant               TaskQuadrant @default(Q2)
  category_id            String?
  priority_id            String?
  has_multiple_schedules Boolean  @default(false)
  is_active              Boolean  @default(true)
  completion_mode        CompletionMode @default(any_can_complete)
  proof_required         Boolean  @default(false)
  // Allowed proof file extensions (empty = any type) — copied to every spawned instance.
  proof_allowed_extensions String[] @default([])
  // Ordered escalation contacts ([userId]) — materialized as TaskEscalation rows
  // (level = position + 1) on every spawned instance so the escalation engine fires.
  escalation_user_ids    Json     @default("[]")
  assignee_user_ids      Json     @default("[]")
  cc_user_ids            Json     @default("[]")
  // Flattened checklist definition ([{ title, group_title?, order_index }]) copied
  // into every spawned instance as TaskChecklist rows.
  checklist_items        Json     @default("[]")
  // Reminder specs ([ReminderSpec]) — resolved to TaskReminder rows per spawned
  // instance (relative ones recomputed against that instance's deadline).
  reminder_specs         Json     @default("[]")
  department_id          String?
  linked_goal_id         String?
  created_by_user_id     String
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  schedule_entries RecurringScheduleEntry[]
  attachments      RecurringTemplateAttachment[]
  access_entries   RecurringTemplateAccess[]

  @@map("recurring_templates")
}

// Google-Drive-style per-template access overrides layered ON TOP of the rule-based
// (scope/participation) visibility. A template's real audience =
//   (rule-based viewers) + (kind=grant rows) − (kind=revoke rows).
// A `grant` lets someone the rules wouldn't otherwise admit see (level=view) or edit
// (level=edit) the template; a `revoke` hides it from someone the rules WOULD admit
// (never the creator or an org-scope admin). One row per (template, user); the
// affected person is notified on add/remove. Managed only by the creator or an admin.
model RecurringTemplateAccess {
  id                    String                @id @default(uuid())
  organization_id       String
  recurring_template_id String
  user_id               String
  kind                  RecurringAccessKind
  level                 RecurringAccessLevel? // set only when kind=grant; null for revoke
  created_by_user_id    String
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt

  template RecurringTemplate @relation(fields: [recurring_template_id], references: [id], onDelete: Cascade)

  @@unique([recurring_template_id, user_id])
  @@index([recurring_template_id])
  @@index([organization_id])
  @@index([user_id])
  @@map("recurring_template_access")
}

// Attachments defined once on a recurring template. On each spawn the scheduler
// copies these into the child task as normal TaskAttachment rows (a fresh R2
// object per child), so every generated instance carries the same documents.
model RecurringTemplateAttachment {
  id                    String    @id @default(uuid())
  organization_id       String
  recurring_template_id String
  file_name             String
  mime_type             String
  size_bytes            Int
  storage_key           String // master object key within the R2 bucket
  uploaded_by_user_id   String
  is_deleted            Boolean   @default(false)
  deleted_at            DateTime?
  created_at            DateTime  @default(now())

  template RecurringTemplate @relation(fields: [recurring_template_id], references: [id], onDelete: Cascade)

  @@index([recurring_template_id])
  @@index([organization_id])
  @@map("recurring_template_attachments")
}

model RecurringScheduleEntry {
  id                    String                @id @default(uuid())
  organization_id       String
  recurring_template_id String
  schedule_type         RecurringScheduleType
  every                 Int                   @default(1)
  days                  Json                  @default("[]")
  month_days            Json                  @default("[]")
  yearly_dates          Json                  @default("[]")
  time                  String                @default("09:00")
  start_date            DateTime
  end_condition         RecurringEndCondition @default(never)
  end_date              DateTime?
  end_after             Int?
  occurrence_count      Int                   @default(0)
  is_active             Boolean               @default(true)
  order_index           Int                   @default(0)
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt

  template RecurringTemplate @relation(fields: [recurring_template_id], references: [id], onDelete: Cascade)

  @@map("recurring_schedule_entries")
}

model TaskArchive {
  id                String   @id @default(uuid())
  organization_id   String
  original_task_id  String
  task_snapshot     Json
  deleted_by_user_id String
  deletion_reason   String?  @db.Text
  deleted_at        DateTime
  created_at        DateTime @default(now())

  @@map("task_archives")
}

model TaskAssigneeFrequency {
  id               String   @id @default(uuid())
  organization_id  String
  assigner_user_id String
  assignee_user_id String
  frequency_count  Int      @default(1)
  last_assigned_at DateTime @default(now())
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@unique([organization_id, assigner_user_id, assignee_user_id])
  @@map("task_assignee_frequencies")
}

