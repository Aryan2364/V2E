// ─── Permission actions (used by RolePermission / UserPermissionOverride) ──────
enum PermissionAction {
  read
  write
  edit
  delete
}

// ─── Restructured permission model (four intersecting layers) ──────────────────
// effective = org_entitlement ∩ ( jobRole_permissions ∪ user_grants − user_revokes )
// Admin leaves are governed by OrganizationMember.is_admin, not by these tables.

enum OverrideEffect {
  grant  // force allow / force eligible
  revoke // force deny / force ineligible
}

enum EntitlementState {
  full
  preview // read-only sandbox (capped to read in resolution)
  off
}

// Row-level data scope — WHICH records a granted action may touch (visibility layer).
// Attached per (role/user, leaf, action). null ⇒ own (fail-closed-narrow).
//   own        — records the actor is a core participant of
//   team       — actor + their recursive reporting subtree
//   department — all members of the actor's own department
//   org        — every record in the org
enum DataScope {
  own
  team
  department
  org
}

// Access-rights are now carried by SYSTEM ROLES (delinked from job titles).
// A SystemRole is the access bundle assigned to an employee: which feature leaves
// it may act on (via RolePermission rows) and the data-scope cascade defaults.
//   - Administrator (is_system) is seeded, locked and non-deletable: full access.
//   - Custom roles are created in the Access Control UI via "+ New".
// `default_scope` is the GLOBAL tier of the living-default scope cascade
// (global → module → line). See SystemRoleModuleScope + RolePermission.scope.
model SystemRole {
  id              String    @id @default(uuid())
  organization_id String
  name            String
  description     String?   @db.Text
  is_system       Boolean   @default(false) // Administrator: locked, non-deletable
  is_admin        Boolean   @default(false) // full access — bypasses the permission matrix
  default_scope   DataScope @default(own) // global tier of the data-scope cascade
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  organization      Organization            @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  permissions       RolePermission[]
  module_scopes     SystemRoleModuleScope[]
  employee_profiles EmployeeProfile[]

  @@unique([organization_id, name])
  @@index([organization_id])
  @@map("system_roles")
}

// Module tier of the data-scope cascade: an optional per-module scope override for a
// system role. Absent row ⇒ that module inherits the role's default_scope.
model SystemRoleModuleScope {
  id             String    @id @default(uuid())
  system_role_id String
  module_key     String // top-level module key, e.g. "tasks","goals"
  scope          DataScope
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  system_role SystemRole @relation(fields: [system_role_id], references: [id], onDelete: Cascade)

  @@unique([system_role_id, module_key])
  @@map("system_role_module_scopes")
}

// Layer 2 — functional baseline: feature permissions per SYSTEM ROLE.
// One row per (org, system_role, feature leaf, action). Missing ⇒ not allowed.
// `scope` is the LINE tier of the cascade; null ⇒ inherit module/default scope.
model RolePermission {
  id                 String           @id @default(uuid())
  organization_id    String
  system_role_id     String // FK SystemRole.id (the access bundle)
  feature_key        String // leaf key, e.g. "tasks.assignment.reassign"
  action             PermissionAction
  allowed            Boolean          @default(false)
  scope              DataScope? // line-tier data scope (content leaves); null ⇒ inherit module/default
  updated_by_user_id String?
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt

  system_role SystemRole @relation(fields: [system_role_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, system_role_id, feature_key, action])
  @@index([organization_id, system_role_id])
  @@map("role_permissions")
}

// Layer 3 — per-user actor deltas. One decision per (user, leaf, action); user wins over role.
model UserPermissionOverride {
  id                 String           @id @default(uuid())
  organization_id    String
  user_id            String
  feature_key        String
  action             PermissionAction
  effect             OverrideEffect
  scope              DataScope? // per-user data-scope override for this action (widens/narrows the role baseline)
  reason             String?
  updated_by_user_id String?
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, user_id, feature_key, action])
  @@index([organization_id, user_id])
  @@map("user_permission_overrides")
}

// Subject eligibility — org default per subject-leaf (default ON preserves today's behavior).
model SubjectEligibilityPolicy {
  id                 String   @id @default(uuid())
  organization_id    String
  subject_key        String // e.g. "tasks.subject.assignable"
  default_eligible   Boolean  @default(true)
  updated_by_user_id String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@unique([organization_id, subject_key])
  @@map("subject_eligibility_policies")
}

// Subject eligibility — per-user delta (grant=force eligible, revoke=force ineligible).
model UserSubjectOverride {
  id                 String         @id @default(uuid())
  organization_id    String
  user_id            String
  subject_key        String
  effect             OverrideEffect
  reason             String? // surfaced as the fail-loud tooltip / validation reason
  updated_by_user_id String?
  created_at         DateTime       @default(now())
  updated_at         DateTime       @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, user_id, subject_key])
  @@index([organization_id, subject_key])
  @@index([organization_id, user_id])
  @@map("user_subject_overrides")
}

// Layer 1 — vendor entitlement ceiling, set only from the superadmin portal.
// Missing row ⇒ off (fail-closed). No in-org actor (incl. org_admin) can exceed it.
model OrgModuleEntitlement {
  id                 String           @id @default(uuid())
  organization_id    String
  module_key         String // top-level module, e.g. "tasks","goals","governance"
  state              EntitlementState @default(off)
  updated_by_user_id String? // a super admin
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, module_key])
  @@map("org_module_entitlements")
}

// ─── Foundational shared Audit Log (software-wide) ─────────────────────────────
model AuditLog {
  id              String   @id @default(uuid())
  organization_id String
  actor_user_id   String?  // NULL for system-triggered entries
  actor_type      String   @default("user") // user | system
  action          String   // create | update | delete | <semantic verb>
  resource        String   // "goal", "access_right", ...
  entity_id       String
  entity_type     String?  // originating Prisma model name (e.g. "Task")
  entity_label    String?  // human-readable (e.g. goal title)
  changes         Json?    // { field: { before, after } }
  trigger_source  String?  // for system entries: "sla_breach", "auto_overdue", ...
  trigger_context Json?    // arbitrary context about the system trigger
  occurred_at     DateTime @default(now()) // business time (respects sim clock)
  request_id      String?
  ip              String?
  user_agent      String?
  created_at      DateTime @default(now()) // physical write time

  actor User? @relation(fields: [actor_user_id], references: [id])

  @@index([organization_id, resource, created_at])
  @@index([organization_id, entity_id])
  @@index([organization_id, created_at])
  @@index([organization_id, actor_type, created_at])
  @@map("audit_logs")
}

// ─── Goals (3-level cascade: objective → annual → quarterly) ───────────────────
enum GoalLevel {
  objective
  annual
  quarterly
}

enum GoalPerspective {
  financial
  customer
  internal_process
  learning_growth
}

enum GoalStatus {
  not_started
  on_track
  at_risk
  achieved
  archived
}

// Owner's RAG judgement call, recorded at each check-in (independent of the
// raw measure math — confidence is the human read on whether the goal lands).
enum GoalConfidence {
  on_track // green
  at_risk // amber
  off_track // red
}

// How often the owner is expected to check in. `none` = ad-hoc, no cadence.
enum GoalCadence {
  none
  weekly
  biweekly
  monthly
  quarterly
}

model Goal {
  id                 String           @id @default(uuid())
  organization_id    String
  level              GoalLevel
  parent_goal_id     String? // NULL only for objective; required for annual/quarterly
  perspective        GoalPerspective? // NULL for objective; set on annual; copied onto quarterly
  title              String
  description        String?          @db.Text
  owner_user_id      String // single accountable person (an employee's user)
  department_id      String?
  start_date         DateTime?
  due_date           DateTime // REQUIRED on every level
  status             GoalStatus       @default(not_started)
  progress_percent   Float            @default(0) // computed from measures / rolled up from children at each check-in
  review_cadence     GoalCadence      @default(none) // expected check-in rhythm
  next_review_date   DateTime? // when the next check-in is due (driven by cadence)
  last_check_in_at   DateTime? // timestamp of the most recent check-in
  last_confidence    GoalConfidence? // owner's most recent RAG call
  is_deleted         Boolean          @default(false)
  deleted_at         DateTime?
  deleted_by_user_id String?
  deletion_reason    String?          @db.Text
  created_by_user_id String
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt

  owner      User          @relation("GoalOwner", fields: [owner_user_id], references: [id])
  department Department?   @relation(fields: [department_id], references: [id])
  parent     Goal?         @relation("GoalHierarchy", fields: [parent_goal_id], references: [id])
  children   Goal[]        @relation("GoalHierarchy")
  measures   GoalMeasure[]
  tasks      Task[]
  check_ins  GoalCheckIn[]

  @@index([organization_id, level])
  @@index([parent_goal_id])
  @@index([organization_id, next_review_date])
  @@map("goals")
}

model GoalMeasure {
  id              String   @id @default(uuid())
  organization_id String
  goal_id         String
  name            String // the metric, e.g. "active hospitals"
  target_value    String // target, e.g. "100" (string keeps units flexible)
  current_value   String?
  unit            String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  goal       Goal             @relation(fields: [goal_id], references: [id], onDelete: Cascade)
  check_ins  MeasureCheckIn[]

  @@index([goal_id])
  @@map("goal_measures")
}

// ─── Goal check-ins (the execution heartbeat) ──────────────────────────────────
// One row per review event on a goal: the owner records the period's actuals
// (MeasureCheckIn rows), a confidence (RAG) call, and a short narrative. The
// computed progress at that moment is snapshotted so history is replayable.
model GoalCheckIn {
  id                 String         @id @default(uuid())
  organization_id    String
  goal_id            String
  check_in_date      DateTime // the date the check-in is "for"
  confidence         GoalConfidence
  progress_percent   Float // snapshot of computed progress at this check-in
  status_note        String?        @db.Text // owner's narrative: what's happening & why
  created_by_user_id String
  created_at         DateTime       @default(now())

  goal           Goal             @relation(fields: [goal_id], references: [id], onDelete: Cascade)
  created_by     User             @relation("GoalCheckInAuthor", fields: [created_by_user_id], references: [id])
  measure_values MeasureCheckIn[]

  @@index([goal_id, check_in_date])
  @@map("goal_check_ins")
}

// The actual value recorded for a single measure at a single check-in — the
// time-series that powers each measure's trajectory chart.
model MeasureCheckIn {
  id               String   @id @default(uuid())
  organization_id  String
  goal_check_in_id String
  goal_measure_id  String
  value            String // recorded actual at this check-in (string keeps units flexible)
  created_at       DateTime @default(now())

  check_in GoalCheckIn @relation(fields: [goal_check_in_id], references: [id], onDelete: Cascade)
  measure  GoalMeasure @relation(fields: [goal_measure_id], references: [id], onDelete: Cascade)

  @@index([goal_measure_id, created_at])
  @@index([goal_check_in_id])
  @@map("measure_check_ins")
}

// ─── Governance: Meetings ──────────────────────────────────────────────────────
enum MeetingType {
  online
  offline
  hybrid
}

enum MeetingStatus {
  scheduled
  in_progress
  closed
  cancelled
}

enum MeetingLinkType {
  goal
  project
  task
  ticket
}

// Opt-out attendance: everyone added is `attending` by default; declining
// (with a required reason) is the only opt-out. No pending, no accept step.
enum MeetingAttendeeResponse {
  attending
  declined
}

model Meeting {
  id                 String           @id @default(uuid())
  organization_id    String
  title              String
  type               MeetingType
  online_link        String?
  online_password    String?
  location           String? // free text (offline / hybrid)
  status             MeetingStatus    @default(scheduled)
  // linkage (single optional link; all null = ad-hoc)
  link_type          MeetingLinkType?
  link_entity_id     String?
  // shared record (layer 1) — markdown
  agenda             String?          @db.Text
  minutes            String?          @db.Text
  // schedule (fixed time — the organiser picks it; the system never decides)
  scheduled_start    DateTime?
  scheduled_end      DateTime?
  actual_start       DateTime?
  actual_end         DateTime?
  reminder_sent      Boolean          @default(false)
  // Attendance ledger honesty: null = attendance was never taken (reads as
  // "not recorded", NEVER as everyone no-showing). Set the first time the
  // organiser records attendance for this meeting.
  attendance_taken_at DateTime?
  // Rhythm linkage: set on instances spawned from a MeetingRhythm. spawn_date is
  // the date-only day the instance was spawned for; the unique pair blocks a
  // second spawn of the same rhythm on the same day (mirrors Task recurrence).
  rhythm_id          String?
  rhythm_spawn_date  DateTime?        @db.Date
  created_by_user_id String // the caller / organizer
  is_deleted         Boolean          @default(false)
  deleted_at         DateTime?
  deleted_by_user_id String?
  deletion_reason    String?          @db.Text
  // Google Calendar mirror (forward sync). When the organiser has connected their
  // Google account, this meeting is mirrored onto their primary calendar with the
  // attendees invited by email. google_event_id = the mirrored event's id (used to
  // update/delete it); google_ical_uid = its iCalUID, the stable key we dedupe on
  // in the reverse view so a mirrored meeting doesn't show twice. null = not mirrored.
  google_event_id    String?
  google_ical_uid    String?
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt

  organizer     User                 @relation("MeetingOrganizer", fields: [created_by_user_id], references: [id])
  rhythm        MeetingRhythm?       @relation(fields: [rhythm_id], references: [id])
  attendees     MeetingAttendee[]
  action_items  MeetingActionItem[]
  decisions     MeetingDecision[]
  private_notes MeetingPrivateNote[]

  @@unique([rhythm_id, rhythm_spawn_date], map: "meetings_rhythm_day_unique")
  @@index([organization_id, status, scheduled_start])
  @@index([rhythm_id])
  @@map("meetings")
}

model MeetingAttendee {
  id              String                  @id @default(uuid())
  organization_id String
  meeting_id      String
  user_id         String
  is_organizer    Boolean                 @default(false)
  // Attending by default (opt-out). Declining requires a reason (reject_reason).
  response        MeetingAttendeeResponse @default(attending)
  reject_reason   String?                 @db.Text // required when response=declined; never overwritten
  // Organiser-set at creation. Required attendees drive busy-view slot ranking;
  // an optional attendee's clash is a warning only. Also lets governance say
  // "declined, but attendance was required". Does NOT reverse a decline.
  is_required     Boolean                 @default(true)
  attended        Boolean                 @default(false)
  attended_in_at  DateTime?
  attended_out_at DateTime?
  created_at      DateTime                @default(now())
  updated_at      DateTime                @updatedAt

  meeting Meeting @relation(fields: [meeting_id], references: [id], onDelete: Cascade)
  user    User    @relation("MeetingAttendeeUser", fields: [user_id], references: [id])

  @@unique([meeting_id, user_id])
  @@map("meeting_attendees")
}

model MeetingActionItem {
  id              String    @id @default(uuid())
  organization_id String
  meeting_id      String
  text            String    @db.Text
  owner_user_id   String?
  due_date        DateTime?
  linked_task_id  String? // manual link/create; nothing auto-creates
  is_done         Boolean   @default(false)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  meeting Meeting @relation(fields: [meeting_id], references: [id], onDelete: Cascade)

  @@index([organization_id, owner_user_id])
  @@map("meeting_action_items")
}

model MeetingDecision {
  id                String           @id @default(uuid())
  organization_id   String
  meeting_id        String
  decision          String           @db.Text
  owner_user_id     String?
  decided_on        DateTime
  reason            String?          @db.Text // one-line why
  affects_link_type MeetingLinkType?
  affects_entity_id String?
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt

  meeting Meeting @relation(fields: [meeting_id], references: [id], onDelete: Cascade)

  @@index([organization_id, decided_on])
  @@map("meeting_decisions")
}

model MeetingPrivateNote {
  id              String   @id @default(uuid())
  organization_id String
  meeting_id      String
  user_id         String
  body            String   @db.Text
  updated_at      DateTime @updatedAt

  meeting Meeting @relation(fields: [meeting_id], references: [id], onDelete: Cascade)

  @@unique([meeting_id, user_id])
  @@map("meeting_private_notes")
}

// ─── Rhythms (recurring meetings) ────────────────────────────────────────────────
// A rhythm is a meeting template on a recurrence. The nightly spawner materialises
// a normal Meeting per due day (see SchedulerService), reusing shouldEntryFireToday
// verbatim — the SAME evaluator the task and work-log engines use. Rhythms are
// fixed-time only (no poll). Holiday policy DIVERGES from tasks: a due day that is
// a holiday is SKIPPED, never slid forward (a Thursday review must not land on Sat).
model MeetingRhythm {
  id                 String           @id @default(uuid())
  organization_id    String
  title              String
  type               MeetingType
  online_link        String?
  online_password    String?
  location           String?
  link_type          MeetingLinkType?
  link_entity_id     String?
  agenda             String?          @db.Text
  duration_min       Int              @default(30)
  // Attendee roster copied to every spawned instance. optional_user_ids is the
  // subset spawned with is_required=false; everyone else is required.
  attendee_user_ids  Json             @default("[]")
  optional_user_ids  Json             @default("[]")
  is_active          Boolean          @default(true)
  created_by_user_id String
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt

  schedule_entries MeetingRhythmSchedule[]
  meetings         Meeting[]

  @@index([organization_id])
  @@map("meeting_rhythms")
}

// Mirrors RecurringScheduleEntry's recurrence columns (per the WorkLogDemandSchedule
// precedent) so shouldEntryFireToday can evaluate it unchanged.
model MeetingRhythmSchedule {
  id                String                @id @default(uuid())
  organization_id   String
  meeting_rhythm_id String
  schedule_type     RecurringScheduleType
  every             Int                   @default(1)
  days              Json                  @default("[]")
  month_days        Json                  @default("[]")
  yearly_dates      Json                  @default("[]")
  time              String                @default("09:00")
  start_date        DateTime
  end_condition     RecurringEndCondition @default(never)
  end_date          DateTime?
  end_after         Int?
  occurrence_count  Int                   @default(0)
  is_active         Boolean               @default(true)
  created_at        DateTime              @default(now())
  updated_at        DateTime              @updatedAt

  rhythm MeetingRhythm @relation(fields: [meeting_rhythm_id], references: [id], onDelete: Cascade)

  @@index([organization_id, is_active])
  @@map("meeting_rhythm_schedules")
}

// ─── Work Log (Governance) ──────────────────────────────────────────────────────

// Per-person per-day log. Everyone has a Daily Update by default.
model DailyUpdate {
  id                String    @id @default(uuid())
  organization_id   String
  user_id           String // the writer
  log_date          DateTime  @db.Date
  stuck             String?   @db.Text // "Where I was stuck today"
  decisions         String?   @db.Text // "Decisions I took today"
  day_summary       String?   @db.Text // "How the overall day was"
  planning_tomorrow String?   @db.Text // "Planning for tomorrow"
  submitted_at      DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  notes WorkLogNote[]

  @@unique([organization_id, user_id, log_date])
  @@map("daily_updates")
}

// Multiple title+description notes per day (three pieces of work → three notes).
model WorkLogNote {
  id              String  @id @default(uuid())
  organization_id String
  daily_update_id String
  title           String
  description     String? @db.Text
  order_index     Int     @default(0)

  daily_update DailyUpdate @relation(fields: [daily_update_id], references: [id], onDelete: Cascade)

  @@map("work_log_notes")
}

// A demanded log (assigner → assignee). kind=one_time has a deadline; kind=recurring has schedule entries.
model WorkLogDemand {
  id               String    @id @default(uuid())
  organization_id  String
  title            String
  description      String?   @db.Text
  assigner_user_id String
  assignee_user_id String
  kind             String // 'one_time' | 'recurring'
  deadline         DateTime? // one_time only
  is_active        Boolean   @default(true)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  schedule_entries WorkLogDemandSchedule[]
  submissions      WorkLogSubmission[]

  @@map("work_log_demands")
}

// Mirror of RecurringScheduleEntry (recurring demands only) — reuses the recurrence enums.
model WorkLogDemandSchedule {
  id               String                @id @default(uuid())
  organization_id  String
  demand_id        String
  schedule_type    RecurringScheduleType
  every            Int                   @default(1)
  days             Json                  @default("[]")
  month_days       Json                  @default("[]")
  yearly_dates     Json                  @default("[]")
  time             String                @default("09:00")
  start_date       DateTime
  end_condition    RecurringEndCondition @default(never)
  end_date         DateTime?
  end_after        Int?
  occurrence_count Int                   @default(0)
  is_active        Boolean               @default(true)
  order_index      Int                   @default(0)
  created_at       DateTime              @default(now())
  updated_at       DateTime              @updatedAt

  demand WorkLogDemand @relation(fields: [demand_id], references: [id], onDelete: Cascade)

  @@map("work_log_demand_schedules")
}

// One occurrence in a demand's series (also the row a daily-folded demand writes into).
model WorkLogSubmission {
  id              String    @id @default(uuid())
  organization_id String
  demand_id       String
  writer_user_id  String
  due_date        DateTime  @db.Date
  period_label    String // e.g. "Fri 20 Jun" / "Jun 2026"
  body            String?   @db.Text
  status          String    @default("pending") // 'pending' | 'submitted'
  submitted_at    DateTime?
  daily_update_id String? // set when folded into a Daily Update (daily frequency)
  created_at      DateTime  @default(now())

  demand WorkLogDemand @relation(fields: [demand_id], references: [id], onDelete: Cascade)

  @@unique([demand_id, due_date])
  @@map("work_log_submissions")
}

// Remarks + threaded replies on any log (polymorphic) — modeled on TaskComment.
model WorkLogRemark {
  id                 String    @id @default(uuid())
  organization_id    String
  target_type        String // 'daily_update' | 'submission'
  target_id          String
  user_id            String
  body               String    @db.Text
  attachment_urls    Json?
  reply_to_remark_id String?
  is_deleted         Boolean   @default(false)
  deleted_at         DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  reply_to_remark WorkLogRemark?  @relation("WLRemarkReplies", fields: [reply_to_remark_id], references: [id])
  replies         WorkLogRemark[] @relation("WLRemarkReplies")

  @@index([organization_id, target_type, target_id])
  @@map("work_log_remarks")
}

// Admin access config: explicit reader → writer read grants. Writers default to everyone.
model WorkLogReaderGrant {
  id              String   @id @default(uuid())
  organization_id String
  reader_user_id  String
  writer_user_id  String
  created_by      String
  created_at      DateTime @default(now())

  @@unique([organization_id, reader_user_id, writer_user_id])
  @@map("work_log_reader_grants")
}

// One row per org — Work Log access settings.
model WorkLogSettings {
  organization_id       String   @id
  managers_read_reports Boolean  @default(true) // managers auto-read their (recursive) reports
  writer_user_ids       Json     @default("[]") // empty => everyone writes; else explicit allowlist
  updated_at            DateTime @updatedAt

  @@map("work_log_settings")
}

// ─── Process Hierarchy (BPMN-lite process explorer) ────────────────────────────
// A visual, recursive drill-down map of "how we do things here" — primarily a
// learning tool. EVERYTHING is a node; nodes nest infinitely (parent_node_id).
// Some nodes are containers/sub-processes you drill into; the deepest hold a
// process flow (Start → steps → End) wired by ProcessConnection edges. Row-level
// visibility is NOT the standard participant scope — it is attachment-based and
// enforced by ProcessAccessService (leaf `process_hierarchy.map.manage` is
// registered `self_scoped`). See project memory `project_process_hierarchy`.

enum ProcessNodeKind {
  container    // holds other nodes; you drill in
  task         // a normal step in a flow
  decision     // a binary Yes/No branch (diamond)
  subprocess   // a step that opens into its own deeper flow (the recursion)
  start_event  // BPMN start marker (no detail panel)
  end_event    // BPMN end marker (no detail panel)
}

enum ProcessNodeStatus {
  draft
  in_review
  final
}

enum ProcessConditionKind {
  none // normal sequence flow
  yes  // the "Yes" branch out of a decision
  no   // the "No" branch out of a decision
}

enum ProcessArtifactType {
  form
  report
  document
  data
  other
}

enum ProcessArtifactDirection {
  input  // a document the node needs
  output // a document the node produces
}

// Mirrors ChecklistTemplateAccessRule: attach dept/role/person at a node, cascade
// down. `exclude_user` = "attached but hidden" exception. Department attaches are
// LIVE rules (joiners/leavers auto-reflect); add/remove of individuals stored as
// extra user / exclude_user rows.
enum ProcessAccessKind {
  department
  role
  user
  exclude_user
}

enum ProcessAccessLevel {
  view // default — read only
  edit // per-node edit grant; only meaningful for Contributors/Admins, never Viewers
}

enum ProcessSnapshotStatus {
  draft
  in_review
  final
}

// A top-level explorer root. Versioning + all nodes/flows/artifacts hang off a map.
model ProcessMap {
  id                 String    @id @default(uuid())
  organization_id    String
  name               String
  description        String?   @db.Text
  is_deleted         Boolean   @default(false)
  deleted_at         DateTime?
  deleted_by_user_id String?
  created_by_user_id String
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  nodes       ProcessNode[]
  connections ProcessConnection[]
  artifacts   ProcessArtifact[]
  snapshots   ProcessSnapshot[]

  @@index([organization_id])
  @@map("process_maps")
}

// EVERYTHING is a node. Nests infinitely via parent_node_id (null = top level of
// the map). container/subprocess nodes are drilled into; their children form the
// deeper flow. responsible_role_id / responsible_user_id are bare-scalar FKs (no
// Prisma relation), matching the codebase convention for cross-entity references.
model ProcessNode {
  id                  String            @id @default(uuid())
  organization_id     String
  map_id              String
  parent_node_id      String? // null = top level of the map
  kind                ProcessNodeKind   @default(task)
  name                String
  description         String?           @db.Text
  status              ProcessNodeStatus @default(draft)
  responsible_role_id String? // -> Role.id (bare scalar)
  responsible_user_id String? // -> User.id (bare scalar)
  position_x          Float             @default(0) // free-form ReactFlow placement
  position_y          Float             @default(0)
  sort_order          Int               @default(0)
  linked_map_id       String? // cross-map link: drilling this node opens another ProcessMap
  is_deleted          Boolean           @default(false)
  deleted_at          DateTime?
  created_by_user_id  String
  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt

  map            ProcessMap            @relation(fields: [map_id], references: [id], onDelete: Cascade)
  parent_node    ProcessNode?          @relation("ProcessNodeTree", fields: [parent_node_id], references: [id])
  child_nodes    ProcessNode[]         @relation("ProcessNodeTree")
  checklist      ProcessChecklistItem[]
  artifact_links ProcessNodeArtifact[]
  access_rules   ProcessNodeAccess[]

  @@index([organization_id])
  @@index([map_id])
  @@index([parent_node_id])
  @@map("process_nodes")
}

// A directed edge in ONE flow: connects two sibling nodes under the same parent.
// parent_node_id scopes the flow (null = the map's root flow). Node refs are bare
// scalars; the service prunes edges when a node is removed.
model ProcessConnection {
  id              String               @id @default(uuid())
  organization_id String
  map_id          String
  parent_node_id  String? // the flow (level) these edges live in; null = map root
  source_node_id  String
  target_node_id  String
  label           String? // e.g. "Yes"/"No" off a decision
  condition_kind  ProcessConditionKind @default(none)
  created_at      DateTime             @default(now())

  map ProcessMap @relation(fields: [map_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@index([map_id])
  @@index([parent_node_id])
  @@map("process_connections")
}

// A document that flows between steps. Metadata-only when the R2 file fields are
// null; a real uploaded file (Cloudflare R2, reusing R2Service) when populated.
// "Sits on the connection" is derived: an artifact that is an OUTPUT of the source
// node and an INPUT of the target node renders on that edge.
model ProcessArtifact {
  id                 String              @id @default(uuid())
  organization_id    String
  map_id             String
  name               String
  description        String?             @db.Text
  artifact_type      ProcessArtifactType @default(document)
  // optional real file (all null = metadata-only)
  file_name          String?
  mime_type          String?
  size_bytes         Int?
  storage_key        String? // object key within the R2 bucket
  created_by_user_id String
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt

  map        ProcessMap            @relation(fields: [map_id], references: [id], onDelete: Cascade)
  node_links ProcessNodeArtifact[]

  @@index([organization_id])
  @@index([map_id])
  @@map("process_artifacts")
}

// Links an artifact to a node as an input or an output (the detail panel's
// Inputs / Outputs, and the source of edge-chip derivation).
model ProcessNodeArtifact {
  id          String                   @id @default(uuid())
  node_id     String
  artifact_id String
  direction   ProcessArtifactDirection
  created_at  DateTime                 @default(now())

  node     ProcessNode     @relation(fields: [node_id], references: [id], onDelete: Cascade)
  artifact ProcessArtifact @relation(fields: [artifact_id], references: [id], onDelete: Cascade)

  @@unique([node_id, artifact_id, direction])
  @@index([node_id])
  @@index([artifact_id])
  @@map("process_node_artifacts")
}

// Tick-off checklist items on a node's detail panel.
model ProcessChecklistItem {
  id         String   @id @default(uuid())
  node_id    String
  text       String
  sort_order Int      @default(0)
  created_at DateTime @default(now())

  node ProcessNode @relation(fields: [node_id], references: [id], onDelete: Cascade)

  @@index([node_id])
  @@map("process_checklist_items")
}

// Attachment / sharing rule at a node — the access engine's raw material. Mirrors
// ChecklistTemplateAccessRule. Rules cascade DOWN the node subtree by default;
// a lower node can add more rules (union) or restrict (exclude_user). dept/role/
// user are bare-scalar FKs.
model ProcessNodeAccess {
  id                      String             @id @default(uuid())
  organization_id         String
  node_id                 String
  kind                    ProcessAccessKind
  level                   ProcessAccessLevel @default(view)
  department_id           String? // when kind = department
  include_sub_departments Boolean            @default(true) // cascade to child depts
  role_id                 String? // when kind = role (dept-scoped Role.id)
  user_id                 String? // when kind = user / exclude_user
  created_by_user_id      String
  created_at              DateTime           @default(now())

  node ProcessNode @relation(fields: [node_id], references: [id], onDelete: Cascade)

  @@index([organization_id, node_id])
  @@index([node_id])
  @@map("process_node_access")
}

// An immutable, named point-in-time copy of a WHOLE map (nodes + connections +
// artifacts + checklists), serialized to tree_json. Powers as-is / to-be
// versioning. Restore replaces the working tree from a snapshot; there is no
// per-node history. (Snapshot DIFF is Phase 2.)
model ProcessSnapshot {
  id                 String                @id @default(uuid())
  organization_id    String
  map_id             String
  label              String // e.g. "As-Is 2026", "To-Be v2"
  status             ProcessSnapshotStatus @default(draft)
  tree_json          Json
  created_by_user_id String
  created_at         DateTime              @default(now())

  map ProcessMap @relation(fields: [map_id], references: [id], onDelete: Cascade)

  @@index([organization_id, map_id])
  @@map("process_snapshots")
}

// A reusable process blueprint — a frozen map tree (same shape as a snapshot) that
// can instantiate a brand-new map. Org-wide; instantiation clones with fresh ids.
model ProcessTemplate {
  id                 String   @id @default(uuid())
  organization_id    String
  name               String
  description        String?  @db.Text
  tree_json          Json
  source_map_id      String? // the map it was created from (informational)
  created_by_user_id String
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@index([organization_id])
  @@map("process_templates")
}


