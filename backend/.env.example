DATABASE_URL="postgresql://postgres:postgres@localhost:5432/orgos?schema=public"

JWT_SECRET="your-jwt-secret-key"
JWT_REFRESH_SECRET="your-refresh-secret-key"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

PORT=3001

# Public URL of the frontend — used to build the sign-in link inside emails.
FRONTEND_URL=http://localhost:3000

# ── Transactional email (password-reset OTP + welcome credentials) ────────────
# SMTP for Gmail / Google Workspace. SMTP_PASS is a 16-char Google App Password
# (NOT the account login password) — create one at https://myaccount.google.com/apppasswords
# Port 465 = implicit TLS/SSL; 587 or 25 = STARTTLS.
# Leave SMTP_HOST / SMTP_USER / SMTP_PASS blank to LOG OTPs & credentials to the
# backend console instead of sending real email (local dev).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=noreply@rgbindia.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=noreply@rgbindia.com

# Web Push (VAPID) - generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Cloudflare R2 (document attachments) — private bucket + Object Read & Write token.
# R2_ENDPOINT is optional; if unset it is derived as https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# Google Calendar sync (per-user OAuth, meetings module). Create one OAuth "Web
# application" client in Google Cloud and register BOTH redirect URIs:
#   http://localhost:3001/api/v1/auth/google/callback   (local dev)
#   https://<your-domain>/api/v1/auth/google/callback    (production)
# CLIENT_ID/SECRET are identical across environments; only CALLBACK_URL differs.
# If these are blank the feature stays hidden (the connect button doesn't appear).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback
# Optional: dedicated 32+ char key to encrypt stored Google refresh tokens.
# If blank, JWT_SECRET is used to derive the key (no extra setup needed).
GCAL_ENC_KEY=
